{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/QSOLKCB/QSOL-SUBSTRATE/schema/adapter-manifest.schema.json",
  "title": "QSOL-SUBSTRATE portable adapter manifest",
  "type": "object",
  "required": ["type", "schema_version", "adapter_spec_version", "substrate", "projection", "adapters", "adapter_bundle_sha256"],
  "properties": {
    "type": {"const": "qsol-substrate-adapter-manifest"},
    "schema_version": {"const": "1.0.0"},
    "adapter_spec_version": {"const": "1.0.0"},
    "substrate": {
      "type": "object",
      "required": ["protocol", "version", "version_kind", "schema_version", "snapshot_date", "source_commit", "substrate_sha256"],
      "properties": {
        "protocol": {"const": "QSOL-SUBSTRATE"},
        "version": {"type": "string", "pattern": "^snapshot-\\d{4}-\\d{2}-\\d{2}$"},
        "version_kind": {"const": "snapshot"},
        "schema_version": {"const": "1.0.0"},
        "snapshot_date": {"type": "string", "format": "date"},
        "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "substrate_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "projection": {
      "type": "object",
      "required": ["scope", "projection_sha256", "fact_transform", "transport_only", "canonical_source_of_truth"],
      "properties": {
        "scope": {"const": "all_normative_machine_contracts_and_canonical_public_payload"},
        "projection_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "fact_transform": {"const": "none"},
        "transport_only": {"const": true},
        "canonical_source_of_truth": {"const": "repository canonical machine records"}
      },
      "additionalProperties": false
    },
    "adapters": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["id", "transport", "identity", "source_substrate_sha256", "projection_sha256", "knowledge_projection_files", "files"],
        "properties": {
          "id": {"enum": ["adapter:generic-single-file", "adapter:grok-chat", "adapter:xai-retrieval", "adapter:grok-build", "adapter:sider", "adapter:ollama", "adapter:openai-compatible", "adapter:anthropic-compatible"]},
          "transport": {"type": "string", "minLength": 1},
          "identity": {"type": "string", "pattern": "^[a-z0-9-]+/1\\.0\\.0$"},
          "source_substrate_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "projection_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "knowledge_projection_files": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/file"}}
        },
        "additionalProperties": false
      }
    },
    "adapter_bundle_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false,
  "$defs": {
    "file": {
      "type": "object",
      "required": ["path", "role", "sha256", "bytes"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "role": {"enum": ["knowledge", "transport_manifest", "project_rules", "skill", "prompt", "modelfile_template", "request_template"]},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "bytes": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    }
  }
}
