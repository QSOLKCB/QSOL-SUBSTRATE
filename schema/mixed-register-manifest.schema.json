{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/QSOLKCB/QSOL-SUBSTRATE/schema/mixed-register-manifest.schema.json",
  "title": "QSOL-SUBSTRATE MIXED-REGISTER/1 manifest",
  "type": "object",
  "required": ["type", "schema_version", "mixed_register_spec_version", "classification_contract_version", "substrate", "artifact_class", "evaluation_only", "canonical_truth_authority", "canonical_source_refs_forbidden", "expected_claim_ids", "claim_count", "files", "bundle_sha256"],
  "properties": {
    "type": {"const": "qsol-mixed-register-manifest"},
    "schema_version": {"const": "1.0.0"},
    "mixed_register_spec_version": {"const": "1.0.0"},
    "classification_contract_version": {"const": "MIXED-REGISTER/1"},
    "substrate": {
      "type": "object",
      "required": ["protocol", "version", "version_kind", "schema_version", "snapshot_date", "source_commit", "substrate_sha256"],
      "properties": {
        "protocol": {"const": "QSOL-SUBSTRATE"},
        "version": {"type": "string", "minLength": 1},
        "version_kind": {"const": "snapshot"},
        "schema_version": {"const": "1.0.0"},
        "snapshot_date": {"type": "string", "format": "date"},
        "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "substrate_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "artifact_class": {"const": "deterministic_evaluation_protocol"},
    "evaluation_only": {"const": true},
    "canonical_truth_authority": {"const": false},
    "canonical_source_refs_forbidden": {"const": true},
    "expected_claim_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^mr1-[0-9]{3}$"}},
    "claim_count": {"type": "integer", "minimum": 1},
    "files": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["path", "sha256", "bytes"],
        "properties": {
          "path": {"enum": ["report.md", "claims.jsonl", "oracle.json", "scoring-contract.json", "scorer.py"]},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "bytes": {"type": "integer", "minimum": 1}
        },
        "additionalProperties": false
      }
    },
    "bundle_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
