{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/QSOLKCB/QSOL-SUBSTRATE/schema/projection-manifest.schema.json",
  "title": "QSOL-SUBSTRATE model projection experiment manifest",
  "type": "object",
  "required": ["type", "schema_version", "projection_spec_version", "substrate", "artifact_class", "canonical_truth_authority", "model_specific_binary_artifacts_in_ci", "epistemic_prefix_sha256", "compatibility", "recipes", "files", "bundle_sha256"],
  "properties": {
    "type": {"const": "qsol-model-projection-manifest"},
    "schema_version": {"const": "1.0.0"},
    "projection_spec_version": {"const": "1.0.0"},
    "substrate": {
      "type": "object",
      "required": ["protocol", "version", "version_kind", "schema_version", "snapshot_date", "source_commit", "substrate_sha256"],
      "properties": {
        "protocol": {"const": "QSOL-SUBSTRATE"},
        "version": {"type": "string", "pattern": "^snapshot-[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "version_kind": {"const": "snapshot"},
        "schema_version": {"const": "1.0.0"},
        "snapshot_date": {"type": "string", "format": "date"},
        "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "substrate_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "artifact_class": {"const": "model_specific_projection_experiment_contract"},
    "canonical_truth_authority": {"const": false},
    "model_specific_binary_artifacts_in_ci": {"const": false},
    "epistemic_prefix_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "compatibility": {
      "type": "object",
      "required": ["schema", "required_exact_match_fields", "invalidate_on_any_mismatch", "tokenizer_or_architecture_change_requires_regeneration"],
      "properties": {
        "schema": {"const": "schema/model-projection-compatibility.schema.json"},
        "required_exact_match_fields": {
          "const": ["projection_kind", "model_id", "model_revision", "architecture", "tokenizer_id", "tokenizer_sha256", "context_length", "hidden_size", "num_hidden_layers", "num_attention_heads", "kv_layout_version"]
        },
        "invalidate_on_any_mismatch": {"const": true},
        "tokenizer_or_architecture_change_requires_regeneration": {"const": true}
      },
      "additionalProperties": false
    },
    "recipes": {
      "const": ["soft-prompt-prefix-tuning", "prompt-tuned-virtual-tokens", "lora-epistemic-adapter", "prefilled-kv-cache", "reusable-prefix-state", "hybrid-epistemic-prefix-factual-text"]
    },
    "files": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["path", "sha256", "bytes"],
        "properties": {
          "path": {"enum": ["delivery-matrix.json", "epistemic-prefix.txt", "projection-recipes.json"]},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "bytes": {"type": "integer", "minimum": 1}
        },
        "additionalProperties": false
      }
    },
    "bundle_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
