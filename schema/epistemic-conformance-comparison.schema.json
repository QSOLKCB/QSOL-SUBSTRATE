{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/QSOLKCB/QSOL-SUBSTRATE/schema/epistemic-conformance-comparison.schema.json",
  "title": "QSOL epistemic conformance comparison",
  "type": "object",
  "$defs": {
    "inference": {
      "type": "object",
      "required": ["context_size", "temperature", "top_p", "top_k", "seed", "sampler", "extra"],
      "properties": {
        "context_size": {"type": ["integer", "null"], "minimum": 1},
        "temperature": {"type": ["number", "null"], "minimum": 0},
        "top_p": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "top_k": {"type": ["integer", "null"], "minimum": 0},
        "seed": {"type": ["integer", "string", "null"]},
        "sampler": {"type": "string", "minLength": 1},
        "extra": {"type": "object"}
      },
      "additionalProperties": false
    }
  },
  "required": ["type", "schema_version", "benchmark", "substrate", "rows"],
  "properties": {
    "type": {"const": "qsol-epistemic-conformance-comparison"},
    "schema_version": {"const": "1.0.0"},
    "benchmark": {
      "type": "object",
      "required": ["id", "sha256"],
      "properties": {
        "id": {"const": "EPISTEMIC-CONFORMANCE/1"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "substrate": {
      "type": "object",
      "required": ["protocol", "source_commit", "substrate_sha256", "delivery"],
      "properties": {
        "protocol": {"const": "QSOL-SUBSTRATE"},
        "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "substrate_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "delivery": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "run_id",
          "model_id",
          "model_revision",
          "provider",
          "runtime",
          "quantization",
          "parameter_count_billion",
          "inference",
          "grader_id",
          "grader_revision",
          "grader_method",
          "external_conformance_score",
          "completion_rate",
          "major_error_count",
          "first_pass_conformance",
          "self_correction_rate",
          "remaining_error_rate",
          "self_score_error",
          "conflict_preservation",
          "historical_state_preservation",
          "identifier_completion_error_rate",
          "cross_domain_overreach_rate",
          "retrieved_text_authority_resistance",
          "verdict"
        ],
        "properties": {
          "run_id": {"type": "string", "minLength": 1},
          "model_id": {"type": "string", "minLength": 1},
          "model_revision": {"type": "string", "minLength": 1},
          "provider": {"type": "string", "minLength": 1},
          "runtime": {"type": "string", "minLength": 1},
          "quantization": {"type": "string", "minLength": 1},
          "parameter_count_billion": {"type": ["number", "null"], "exclusiveMinimum": 0},
          "inference": {"$ref": "#/$defs/inference"},
          "grader_id": {"type": "string", "minLength": 1},
          "grader_revision": {"type": "string", "minLength": 1},
          "grader_method": {"const": "human_external"},
          "external_conformance_score": {"type": "number", "minimum": 0, "maximum": 1},
          "completion_rate": {"type": "number", "minimum": 0, "maximum": 1},
          "major_error_count": {"type": "integer", "minimum": 0},
          "first_pass_conformance": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
          "self_correction_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
          "remaining_error_rate": {"type": "number", "minimum": 0, "maximum": 1},
          "self_score_error": {"type": ["number", "null"], "minimum": -1, "maximum": 1},
          "conflict_preservation": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
          "historical_state_preservation": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
          "identifier_completion_error_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
          "cross_domain_overreach_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
          "retrieved_text_authority_resistance": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
          "verdict": {"enum": ["CONFORMANT", "PARTIALLY_CONFORMANT", "NON_CONFORMANT"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
