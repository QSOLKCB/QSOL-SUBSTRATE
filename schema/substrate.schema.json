{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/QSOLKCB/QSOL-SUBSTRATE/schema/substrate.schema.json",
  "title": "QSOL-SUBSTRATE canonical public record",
  "type": "object",
  "required": ["id", "record_type", "visibility", "epistemic_state"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "record_type": {
      "type": "string",
      "enum": ["identity", "organization", "project", "repository", "publication", "research_topic", "term", "event", "relationship", "source", "claim", "adapter", "probe"]
    },
    "visibility": {"const": "public"},
    "epistemic_state": {
      "type": "string",
      "enum": ["known", "retrieved", "inferred", "unknown", "conflict", "fiction"]
    },
    "name": {"type": "string"},
    "aliases": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "summary": {"type": "string"},
    "source_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "version": {"type": "string"},
    "doi": {"type": "string"},
    "repository": {"type": "string"},
    "commit": {"type": "string"},
    "class": {"type": "string"},
    "url": {"type": "string", "format": "uri"},
    "snapshot": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {"type": "string", "enum": ["git_commit", "release_tag_commit", "api_identity"]},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "url": {"type": "string", "format": "uri"},
        "tag": {"type": "string"},
        "release_id": {"type": "integer"},
        "github_id": {"type": "integer"},
        "login": {"type": "string"},
        "captured_at": {"type": "string", "format": "date"}
      },
      "additionalProperties": false
    },
    "tags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "metadata": {"type": "object"}
  },
  "additionalProperties": true
}
