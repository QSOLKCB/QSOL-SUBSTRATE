{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/QSOLKCB/QSOL-SUBSTRATE/schema/model-run.schema.json",
  "title": "QSOL-SUBSTRATE probe model run",
  "type": "object",
  "$defs": {
    "projectionCompatibility": {
      "type": "object",
      "required": ["type", "schema_version", "projection_kind", "model_id", "model_revision", "architecture", "tokenizer_id", "tokenizer_sha256", "context_length", "hidden_size", "num_hidden_layers", "num_attention_heads", "kv_layout_version", "tensor_dtype", "kv_cache_dtype", "quantization_id"],
      "properties": {
        "type": {"const": "qsol-model-projection-compatibility"},
        "schema_version": {"const": "1.0.0"},
        "projection_kind": {"enum": ["soft_prompt", "virtual_tokens", "lora", "kv_cache", "prefix_state", "hybrid"]},
        "model_id": {"type": "string", "minLength": 1},
        "model_revision": {"type": "string", "minLength": 1},
        "architecture": {"type": "string", "minLength": 1},
        "tokenizer_id": {"type": "string", "minLength": 1},
        "tokenizer_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "context_length": {"type": "integer", "minimum": 1},
        "hidden_size": {"type": "integer", "minimum": 1},
        "num_hidden_layers": {"type": "integer", "minimum": 1},
        "num_attention_heads": {"type": "integer", "minimum": 1},
        "kv_layout_version": {"type": "string", "minLength": 1},
        "tensor_dtype": {"type": "string", "minLength": 1},
        "kv_cache_dtype": {"type": "string", "minLength": 1},
        "quantization_id": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "projectionExecution": {
      "type": "object",
      "required": ["executed", "backend", "artifact_sha256", "runtime_evidence_sha256", "compatibility"],
      "properties": {
        "executed": {"const": true},
        "backend": {"type": "string", "minLength": 1},
        "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "runtime_evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "compatibility": {"$ref": "#/$defs/projectionCompatibility"}
      },
      "additionalProperties": false
    }
  },
  "required": ["type", "schema_version", "run_id", "execution_kind", "model", "condition", "probe_bundle_sha256", "substrate", "usage", "responses"],
  "properties": {
    "type": {"const": "qsol-probe-model-run"},
    "schema_version": {"const": "1.0.0"},
    "run_id": {"type": "string", "minLength": 1},
    "execution_kind": {"enum": ["model", "scoring_oracle"]},
    "model": {
      "type": "object",
      "required": ["id", "revision", "provider"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "provider": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "condition": {"enum": ["naked", "micro", "standard", "full", "vector", "latent-prefix", "hybrid", "tool-enabled"]},
    "probe_bundle_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "substrate": {
      "type": "object",
      "required": ["protocol", "version", "version_kind", "schema_version", "snapshot_date", "source_commit", "substrate_sha256"],
      "properties": {
        "protocol": {"const": "QSOL-SUBSTRATE"},
        "version": {"type": "string"},
        "version_kind": {"const": "snapshot"},
        "schema_version": {"const": "1.0.0"},
        "snapshot_date": {"type": "string", "format": "date"},
        "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "substrate_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "usage": {
      "type": "object",
      "required": ["input_tokens", "output_tokens", "tokenizer"],
      "properties": {
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "tokenizer": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "projection_execution": {"$ref": "#/$defs/projectionExecution"},
    "responses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["probe_id", "raw_answer", "epistemic_state", "answer", "canonical_ids", "provenance_refs", "classification", "sarcasm", "hostility", "intent_polarity", "severity", "confidence", "freshness_limited"],
        "properties": {
          "probe_id": {"type": "string", "minLength": 1},
          "raw_answer": {"type": "string"},
          "epistemic_state": {"enum": ["known", "retrieved", "inferred", "unknown", "conflict", "fiction"]},
          "answer": {"type": ["string", "null"]},
          "canonical_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "provenance_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "classification": {"type": ["string", "null"]},
          "sarcasm": {"type": ["string", "null"], "enum": ["yes", "no", "uncertain", null]},
          "hostility": {"type": ["string", "null"], "enum": ["none", "mock", "actual", "uncertain", null]},
          "intent_polarity": {"type": ["string", "null"], "enum": ["positive", "negative", "neutral", "uncertain", null]},
          "severity": {"type": ["string", "null"], "enum": ["low", "moderate", "high", "critical", "unknown", null]},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "freshness_limited": {"type": ["boolean", "null"]}
        },
        "allOf": [
          {
            "if": {"properties": {"epistemic_state": {"const": "unknown"}}, "required": ["epistemic_state"]},
            "then": {"properties": {"answer": {"type": "null"}}}
          }
        ],
        "additionalProperties": false
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "execution_kind": {"const": "model"},
          "condition": {"enum": ["latent-prefix", "hybrid"]}
        },
        "required": ["execution_kind", "condition"]
      },
      "then": {"required": ["projection_execution"]},
      "else": {"not": {"required": ["projection_execution"]}}
    }
  ],
  "additionalProperties": false
}
