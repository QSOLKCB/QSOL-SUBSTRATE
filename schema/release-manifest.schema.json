{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/QSOLKCB/QSOL-SUBSTRATE/schema/release-manifest.schema.json",
  "title": "QSOL-SUBSTRATE release manifest",
  "type": "object",
  "required": ["type", "schema_version", "release_spec_version", "release", "substrate", "components", "reproducibility", "archive", "files", "release_sha256"],
  "properties": {
    "type": {"const": "qsol-substrate-release-manifest"},
    "schema_version": {"const": "1.0.0"},
    "release_spec_version": {"const": "1.0.0"},
    "release": {
      "type": "object",
      "required": ["name", "version", "channel", "tag", "publishable"],
      "properties": {
        "name": {"const": "QSOL-SUBSTRATE"},
        "version": {"type": "string", "minLength": 1},
        "channel": {"enum": ["stable", "candidate", "ci"]},
        "tag": {"type": "string", "pattern": "^v.+$"},
        "publishable": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "substrate": {
      "type": "object",
      "required": ["protocol", "schema_version", "snapshot_date", "snapshot_id", "source_commit", "substrate_sha256"],
      "properties": {
        "protocol": {"const": "QSOL-SUBSTRATE"},
        "schema_version": {"const": "1.0.0"},
        "snapshot_date": {"type": "string", "format": "date"},
        "snapshot_id": {"type": "string", "pattern": "^snapshot-[0-9]{4}-[0-9]{2}-[0-9]{2}@sha256:[0-9a-f]{64}$"},
        "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "substrate_sha256": {"$ref": "#/$defs/hash"}
      },
      "additionalProperties": false
    },
    "components": {
      "type": "object",
      "required": ["adapters", "toolless", "vectors", "projections", "probes"],
      "properties": {
        "adapters": {"$ref": "#/$defs/component"},
        "toolless": {
          "allOf": [
            {"$ref": "#/$defs/component"},
            {
              "type": "object",
              "required": ["profiles"],
              "properties": {
                "profiles": {
                  "type": "array",
                  "minItems": 3,
                  "maxItems": 3,
                  "items": {
                    "type": "object",
                    "required": ["name", "sha256"],
                    "properties": {
                      "name": {"enum": ["MICRO", "STANDARD", "FULL"]},
                      "sha256": {"$ref": "#/$defs/hash"}
                    },
                    "additionalProperties": false
                  }
                }
              }
            }
          ]
        },
        "vectors": {
          "allOf": [
            {"$ref": "#/$defs/component"},
            {
              "type": "object",
              "required": ["index_sha256", "embeddings_sha256"],
              "properties": {
                "index_sha256": {"$ref": "#/$defs/hash"},
                "embeddings_sha256": {"$ref": "#/$defs/hash"}
              }
            }
          ]
        },
        "projections": {
          "allOf": [
            {"$ref": "#/$defs/component"},
            {
              "type": "object",
              "required": ["compatibility_schema", "model_specific_binary_artifacts_included", "compatibility_metadata_required"],
              "properties": {
                "compatibility_schema": {"const": "schema/model-projection-compatibility.schema.json"},
                "model_specific_binary_artifacts_included": {"const": false},
                "compatibility_metadata_required": {"const": true}
              }
            }
          ]
        },
        "probes": {
          "allOf": [
            {"$ref": "#/$defs/component"},
            {
              "type": "object",
              "required": ["snapshot_file", "snapshot_sha256", "probe_count"],
              "properties": {
                "snapshot_file": {"const": "probe-snapshot.json"},
                "snapshot_sha256": {"$ref": "#/$defs/hash"},
                "probe_count": {"const": 48}
              }
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "reproducibility": {
      "type": "object",
      "required": ["build_plan", "build_plan_sha256", "source_commit_verified", "tracked_source_clean", "network_required"],
      "properties": {
        "build_plan": {"const": "build-plan.json"},
        "build_plan_sha256": {"$ref": "#/$defs/hash"},
        "source_commit_verified": {"const": true},
        "tracked_source_clean": {"const": true},
        "network_required": {"const": false}
      },
      "additionalProperties": false
    },
    "archive": {
      "type": "object",
      "required": ["metadata_file", "metadata_sha256", "doi_required", "doi", "provider", "status"],
      "properties": {
        "metadata_file": {"const": "archive-metadata.json"},
        "metadata_sha256": {"$ref": "#/$defs/hash"},
        "doi_required": {"const": false},
        "doi": {"type": ["string", "null"]},
        "provider": {"const": "Zenodo"},
        "status": {"enum": ["unassigned", "reserved", "published"]}
      },
      "additionalProperties": false
    },
    "files": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["path", "sha256", "bytes"],
        "properties": {
          "path": {"enum": ["archive-metadata.json", "build-plan.json", "probe-snapshot.json"]},
          "sha256": {"$ref": "#/$defs/hash"},
          "bytes": {"type": "integer", "minimum": 1}
        },
        "additionalProperties": false
      }
    },
    "release_sha256": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "component": {
      "type": "object",
      "required": ["manifest", "manifest_sha256", "bundle_sha256"],
      "properties": {
        "manifest": {"type": "string", "minLength": 1},
        "manifest_sha256": {"$ref": "#/$defs/hash"},
        "bundle_sha256": {"$ref": "#/$defs/hash"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
